FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    nodejs npm \
    curl \
    git \
    nano \
    libportaudio2 \
    portaudio19-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt pyproject.toml package.json package-lock.json* ./
COPY agent/ ./agent/
COPY web_avatar/ ./web_avatar/
COPY docker/entrypoint.sh /app/docker/entrypoint.sh

RUN chmod +x /app/docker/entrypoint.sh

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --upgrade pip && pip install -r requirements.txt && \
    pip install --force-reinstall --no-cache-dir sounddevice

RUN npm ci && cd web_avatar && npm ci && cd ..

# Set PYTHONPATH for Python module imports
ENV PYTHONPATH=/app

# Fix permissions for node_modules binaries
RUN chmod -R +x /app/node_modules/.bin 2>/dev/null || true && \
    chmod -R +x /app/web_avatar/node_modules/.bin 2>/dev/null || true

EXPOSE 8765 5173

CMD ["/app/docker/entrypoint.sh"]
